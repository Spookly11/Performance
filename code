-- Restore toggle states (Ping/FPS/Leaderboard/Session Kills/Execution/Players)
-- from the previous execution. Locked toggles (Leaderboard/Session Kills
-- outside the allowed game) still get forced off at runtime by their
-- update functions below regardless of what's restored here.
if savedPrefs.toggles then
    for key, value in pairs(savedPrefs.toggles) do
        if enabled[key] ~= nil then
            enabled[key] = value
        end
    end
end

local function persistPosition(pos)
    savedPrefs.x = pos.X.Offset
    savedPrefs.y = pos.Y.Offset
    savedPrefs.locked = dragLocked
    savePrefs(savedPrefs)
end

local function persistToggleState(stateKey)
    savedPrefs.toggles = savedPrefs.toggles or {}
    savedPrefs.toggles[stateKey] = enabled[stateKey]
    savePrefs(savedPrefs)
end

-- Last emote received, remembered across executions the same way position/
