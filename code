-- ============================================================
-- SESSION STOPWATCH
-- ============================================================


local function formatElapsedTime(totalSeconds)
    totalSeconds = math.max(0, math.floor(totalSeconds))
    local days = math.floor(totalSeconds / 86400)
    local hours = math.floor((totalSeconds % 86400) / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60
    return ("%d:%02d:%02d:%02d"):format(days, hours, minutes, seconds)
end

task.spawn(function()
    while stopwatchLabel.Parent do
        stopwatchLabel.Text = "Session Time: " .. formatElapsedTime(os.clock() - sessionStartTime)
        task.wait(1)
    end
end)

-- ============================================================
-- DRAGGING
-- ============================================================

local dragging = false
local dragInput
local dragStart
local startPos

local function beginDrag(input)
    if dragLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = topBar.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                persistPosition(topBar.Position)
            end
        end)
    end
end

local function trackDragInput(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end


topBar.Active = true
topBar.InputBegan:Connect(beginDrag)
topBar.InputChanged:Connect(trackDragInput)

lockButton.InputBegan:Connect(beginDrag)
lockButton.InputChanged:Connect(trackDragInput)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        topBar.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

