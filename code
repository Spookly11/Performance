    else
        sessionKillsLabel.Text = "Session Kills: Disabled"
        sessionKillsLabel.TextColor3 = COLORS.disabledGray
    end

    if sessionKillsToggle then
        sessionKillsToggle.Refresh()
    end
end

-- Hooks .Changed on the leaderstats values so kills update the instant the
-- server changes them, instead of on a timer. Falls back to just showing
-- whatever's there if leaderstats hasn't loaded in yet.
local function hookLeaderboardLiveUpdates()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if not leaderstats then
        leaderstats = LocalPlayer:WaitForChild("leaderstats", 10)
    end
    if not leaderstats then return end

    local monthlyStat = leaderstats:FindFirstChild("Kills")
    local totalStat = leaderstats:FindFirstChild("Total Kills")

    if monthlyStat then
        table.insert(lbConnections, monthlyStat.Changed:Connect(updateLbDisplay))
    end
    if totalStat then
        sessionKillsBaseline = totalStat.Value
        table.insert(lbConnections, totalStat.Changed:Connect(function()
            updateLbDisplay()
            updateSessionKillsDisplay()
        end))
        updateSessionKillsDisplay()
    end
end

updateLbDisplay()
updateSessionKillsDisplay()
task.spawn(hookLeaderboardLiveUpdates)

-- ============================================================
-- SESSION STOPWATCH
-- ============================================================
-- Counts up from sessionStartTime (set on the very first line of the
-- script, before anything else runs, so there's no avoidable startup slack
-- between "script starts" and "stopwatch starts"). Format is D:HH:MM:SS.

local function formatElapsedTime(totalSeconds)
    totalSeconds = math.max(0, math.floor(totalSeconds))
    local days = math.floor(totalSeconds / 86400)
    local hours = math.floor((totalSeconds % 86400) / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = totalSeconds % 60
    return ("%d:%02d:%02d:%02d"):format(days, hours, minutes, seconds)
end

task.spawn(function()
    while stopwatchLabel.Parent do
        stopwatchLabel.Text = formatElapsedTime(os.clock() - sessionStartTime)
        task.wait(1)
    end
end)

-- ============================================================
-- DRAGGING
-- ============================================================

local dragging = false
local dragInput
local dragStart
local startPos

-- Keeps the settings panel glued to the right edge of the main box
-- as it gets dragged around.
local function updateSettingsContainerPosition()
    settingsContainer.Position = UDim2.new(
        0, mainFrame.Position.X.Offset + mainFrame.Size.X.Offset + 16,
        0, mainFrame.Position.Y.Offset
    )
end

mainFrame.Active = true
mainFrame.InputBegan:Connect(function(input)
    if dragLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                saveCurrentPrefs(mainFrame.Position, dragLocked)
            end
        end)
    end
end)

mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        updateSettingsContainerPosition()
    end
end)

-- Places the settings panel correctly on first load, in case the main box
-- was restored to a saved (non-default) position above.
updateSettingsContainerPosition()

