-- ---------- Emote progress helpers ----------
-- Mirrors the game's own Spin-label logic (found in the game's client
-- scripts): kills since the last emote = TotalKillsFrb - LastEmoteSpin,
-- and a new emote unlocks every EMOTE_KILL_INTERVAL (50) kills.

local cachedEmotesTable = nil -- caches require(ReplicatedStorage.Emotes):GetTable()

local function getAllEmotesTable()
    if cachedEmotesTable then return cachedEmotesTable end
    local ok, result = pcall(function()
        local emotesModule = game.ReplicatedStorage:FindFirstChild("Emotes")
        return emotesModule and require(emotesModule):GetTable()
    end)
    if ok and result then
        cachedEmotesTable = result
        return result
    end
    return nil
end

-- Shared name resolution for a raw GetTable() entry - used both for display
-- and for matching against LIMITED_EMOTE_NAMES. The exact schema isn't
-- confirmed (see the debug dump below to nail it down for real).
local function resolveEntryName(key, entry)
    if type(entry) == "table" then
        return entry.Name or entry.DisplayName or entry.name or tostring(key)
    elseif type(entry) == "string" then
        return entry
    end
    return tostring(key)
end

-- Total obtainable emotes: every catalog entry whose resolved name isn't in
-- LIMITED_EMOTE_NAMES.
local function countObtainableEmotes(t)
    if not t then return 0 end
    local count = 0
    for key, entry in pairs(t) do
        if not LIMITED_EMOTE_NAMES[resolveEntryName(key, entry)] then
            count = count + 1
        end
    end
    return count
end

local function getOwnedEmoteIds()
    local ok, result = pcall(function()
        return HttpService:JSONDecode(LocalPlayer:GetAttribute("Emotes") or "[]")
    end)
    if ok and result then return result end
    return {}
end

local function getKillsUntilNextEmote()
    local totalKills = LocalPlayer:GetAttribute("TotalKillsFrb") or 0
    local lastSpin = LocalPlayer:GetAttribute("LastEmoteSpin") or -100
    local sinceLast = totalKills - lastSpin
    return math.max(0, EMOTE_KILL_INTERVAL - sinceLast)
end

-- Best-effort display name for an emote id/key - the exact schema of
-- GetTable()'s entries isn't guaranteed, so this falls back to the raw
-- key if no readable name field is found.
local function getEmoteDisplayName(emoteKey)
    local allEmotes = getAllEmotesTable()
    local entry = allEmotes and allEmotes[emoteKey]
    return resolveEntryName(emoteKey, entry)
end

local function getUsername()
    if LocalPlayer.DisplayName and LocalPlayer.DisplayName ~= LocalPlayer.Name then
        return LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")"
    end
    return LocalPlayer.Name
end


local function formatNumberWithCommas(n)
    local formatted = tostring(n)
    local isNegative = formatted:sub(1, 1) == "-"
    if isNegative then formatted = formatted:sub(2) end
    local k
    repeat
        formatted, k = formatted:gsub("^(%d+)(%d%d%d)", "%1,%2")
    until k == 0
    if isNegative then formatted = "-" .. formatted end
    return formatted
end

