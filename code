local settingsOpen = false
local menuSizeTween

local function setSettingsOpen(open)
    settingsOpen = open

    -- Cancel whatever's still playing before starting the opposite
    -- animation, otherwise an open/close/open in quick succession leaves two
    -- tweens fighting over the same Size property.
    if menuSizeTween then menuSizeTween:Cancel() end

    if open then
        settingsMenu.Visible = true
        menuSizeTween = TweenService:Create(settingsMenu, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, SETTINGS_WIDTH, 0, SETTINGS_HEIGHT)
        })
        menuSizeTween:Play()
    else
        menuSizeTween = TweenService:Create(settingsMenu, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0)
        })
        menuSizeTween:Play()
        menuSizeTween.Completed:Connect(function()
            if not settingsOpen then
                settingsMenu.Visible = false
            end
        end)
    end
end

