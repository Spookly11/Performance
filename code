-- EMOTE PROGRESS DISPLAY
-- ============================================================
-- Locked outside the allowed game (like Leaderboard/Session Kills) since it
-- depends on that game's specific Emotes module + TotalKillsFrb/LastEmoteSpin
-- attributes.

local knownOwnedEmoteIds = {} -- set of ids we've already seen, used to spot newly granted ones

local function snapshotOwnedEmotes()
    knownOwnedEmoteIds = {}
    for _, id in ipairs(getOwnedEmoteIds()) do
        knownOwnedEmoteIds[id] = true
    end
end

function updateEmoteDisplay()
    if emoteLocked then
        enabled.emotes = false
    end

    if enabled.emotes then
        local killsLeft = getKillsUntilNextEmote()
        nextEmoteLabel.Text = killsLeft <= 0
            and "Next Emote: Ready!"
            or ("Next Emote: " .. formatNumberWithCommas(killsLeft) .. " Kills")
        nextEmoteLabel.TextColor3 = COLORS.white

        local ownedIds = getOwnedEmoteIds()
        local totalCount = countObtainableEmotes(getAllEmotesTable())
        emotesOwnedLabel.Text = "Emotes: " .. #ownedIds .. "/" .. (totalCount > 0 and totalCount or "?")
        emotesOwnedLabel.TextColor3 = COLORS.white
        emotesDisclaimerLabel.Text = "(Excludes Limiteds)"
        emotesDisclaimerLabel.TextColor3 = COLORS.disabledGray

        lastEmoteLabel.Text = "Last Emote: " .. (lastEmoteName or "None yet")
        lastEmoteLabel.TextColor3 = COLORS.white
    else
        nextEmoteLabel.Text = "Next Emote: Disabled"
        emotesOwnedLabel.Text = "Emotes: Disabled"
        lastEmoteLabel.Text = "Last Emote: Disabled"
        emotesDisclaimerLabel.Text = ""
        nextEmoteLabel.TextColor3 = COLORS.disabledGray
        emotesOwnedLabel.TextColor3 = COLORS.disabledGray
        lastEmoteLabel.TextColor3 = COLORS.disabledGray
    end

    if emotesToggle then
        emotesToggle.Refresh()
    end
end

-- Whenever the owned-emotes list grows, diff it against the last known set
-- to figure out which one was just granted, resolve its display name, and
-- persist it so "Last Emote" survives across executions.
local function checkForNewEmote()
    local ownedIds = getOwnedEmoteIds()
    for _, id in ipairs(ownedIds) do
        if not knownOwnedEmoteIds[id] then
            lastEmoteName = getEmoteDisplayName(id)
            persistLastEmote(lastEmoteName)
        end
    end
    snapshotOwnedEmotes()
    updateEmoteDisplay()
end

local emoteConnections = {}

if not emoteLocked then
    snapshotOwnedEmotes() -- baseline so existing emotes aren't misread as "new" on load
    table.insert(emoteConnections, LocalPlayer:GetAttributeChangedSignal("Emotes"):Connect(checkForNewEmote))
    table.insert(emoteConnections, LocalPlayer:GetAttributeChangedSignal("TotalKillsFrb"):Connect(updateEmoteDisplay))
    table.insert(emoteConnections, LocalPlayer:GetAttributeChangedSignal("LastEmoteSpin"):Connect(updateEmoteDisplay))
end

