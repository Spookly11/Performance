-- Recomputes currentFPS every ~1s (a 1-frame FPS number jitters too much to
-- be readable), then immediately reflects both ping and fps to the UI.
-- Ping itself is looked up fresh every time too, so both are "live".
local renderConn
renderConn = RunService.RenderStepped:Connect(function(dt)
    fpsFrameCount += 1
    fpsAccumTime += dt
    if fpsAccumTime >= 1 then
        currentFPS = fpsFrameCount / fpsAccumTime
        fpsFrameCount = 0
        fpsAccumTime = 0
        updateFpsDisplay()
        updatePingDisplay()
    end
end)

updatePingDisplay()
updateFpsDisplay()

