-- ============================================================
-- HELPERS: color lookups
-- ============================================================

local function getPingColor(ping)
    if ping >= 100 then return Color3.fromRGB(255, 0, 0)
    elseif ping >= 85 then return Color3.fromRGB(255, 55, 0)
    elseif ping >= 70 then return Color3.fromRGB(255, 132, 0)
    elseif ping >= 50 then return Color3.fromRGB(255, 208, 0)
    elseif ping >= 40 then return Color3.fromRGB(242, 255, 0)
    elseif ping >= 30 then return Color3.fromRGB(166, 255, 0)
    elseif ping >= 15 then return Color3.fromRGB(38, 255, 0)
    else return Color3.fromRGB(0, 255, 98)
    end
end

local function getFpsColor(fps)
    if fps < 10 then return Color3.fromRGB(255, 0, 0)
    elseif fps <= 20 then return Color3.fromRGB(255, 55, 0)
    elseif fps <= 30 then return Color3.fromRGB(255, 132, 0)
    elseif fps <= 45 then return Color3.fromRGB(255, 208, 0)
    elseif fps <= 60 then return Color3.fromRGB(242, 255, 0)
    elseif fps <= 80 then return Color3.fromRGB(166, 255, 0)
    elseif fps <= 95 then return Color3.fromRGB(38, 255, 0)
    else return Color3.fromRGB(0, 255, 98)
    end
end

-- ============================================================
-- HELPERS: data getters
-- ============================================================

local function getPing()
    local ok, result = pcall(function()
        local networkStats = Stats.Network
        local pingItem = networkStats.ServerStatsItem["Data Ping"]
        return math.floor(pingItem:GetValue())
    end)
    if ok then return result end
    return 0
end


local function getFps()
    return math.floor(currentFPS + 0.5)
end


local function getLeaderboardStats()
    local monthly, total = nil, nil
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local m = leaderstats:FindFirstChild("Kills")
        local t = leaderstats:FindFirstChild("Total Kills")
        if m then monthly = m.Value end
        if t then total = t.Value end
    end
    return monthly, total
end

local function getUsername()
    if LocalPlayer.DisplayName and LocalPlayer.DisplayName ~= LocalPlayer.Name then
        return LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")"
    end
    return LocalPlayer.Name
end


local function formatNumberWithCommas(n)
    local formatted = tostring(n)
    local isNegative = formatted:sub(1, 1) == "-"
    if isNegative then formatted = formatted:sub(2) end
    local k
    repeat
        formatted, k = formatted:gsub("^(%d+)(%d%d%d)", "%1,%2")
    until k == 0
    if isNegative then formatted = "-" .. formatted end
    return formatted
end

