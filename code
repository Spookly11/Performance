function updateSessionKillsDisplay()

    if sessionKillsLocked then
        enabled.sessionkills = false
    end

    if enabled.sessionkills then
        local _, total = getLeaderboardStats()
        if total and sessionKillsBaseline then
            sessionKillsLabel.Text = "Session Kills: " .. formatNumberWithCommas(total - sessionKillsBaseline)
            sessionKillsLabel.TextColor3 = COLORS.white
        else
            sessionKillsLabel.Text = "Session Kills: N/A"
            sessionKillsLabel.TextColor3 = COLORS.disabledGray
        end
    else
        sessionKillsLabel.Text = "Session Kills: Disabled"
        sessionKillsLabel.TextColor3 = COLORS.disabledGray
    end

    if sessionKillsToggle then
        sessionKillsToggle.Refresh()
    end
end


