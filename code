local toggles = {}

local function createToggleRow(name, yPos, labelText, stateKey, locked, onToggle)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 330, 0, yPos)
    label.Size = UDim2.new(0, 110, 0, 22)
    label.Font = Enum.Font.Gotham
    label.Text = labelText
    label.TextColor3 = COLORS.white
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 11
    label.Parent = settingsMenu

    local toggleFrame = Instance.new("Frame")
    toggleFrame.Name = name .. "Toggle"
    toggleFrame.Position = UDim2.new(0, 456, 0, yPos - 1)
    toggleFrame.Size = UDim2.new(0, 44, 0, 22)
    toggleFrame.BackgroundColor3 = enabled[stateKey] and COLORS.toggleOn or COLORS.toggleOff
    toggleFrame.BackgroundTransparency = ELEMENT_TRANSPARENCY
    toggleFrame.ZIndex = 11
    toggleFrame.Parent = settingsMenu

    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleFrame

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = enabled[stateKey] and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = COLORS.white
    knob.BackgroundTransparency = 0.05
    knob.ZIndex = 12
    knob.Parent = toggleFrame

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local button = Instance.new("TextButton")
    button.BackgroundTransparency = 1
    button.Size = UDim2.new(1, 0, 1, 0)
    button.Text = ""
    button.ZIndex = 13
    button.Parent = toggleFrame

    local toggleObj = { Frame = toggleFrame, Knob = knob, Key = stateKey, Locked = locked }

    -- Locked toggles (Leaderboard / Session Kills outside the allowed game)
    -- always render as gray + off, regardless of the underlying `enabled`
    -- value, and never move when clicked. This is what keeps Session Kills
    -- visually disabled instead of looking live and tappable.
    local function refreshVisual()
        if toggleObj.Locked then
            toggleFrame.BackgroundColor3 = COLORS.disabledGray
            TweenService:Create(knob, TweenInfo.new(0.15), { Position = UDim2.new(0, 2, 0, 2) }):Play()
            return
        end
        local on = enabled[stateKey]
        toggleFrame.BackgroundColor3 = on and COLORS.toggleOn or COLORS.toggleOff
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = on and UDim2.new(1, -20, 0, 2) or UDim2.new(0, 2, 0, 2)
        }):Play()
    end

    toggleObj.Refresh = refreshVisual
    refreshVisual()

    button.MouseButton1Click:Connect(function()
        if toggleObj.Locked then return end
        enabled[stateKey] = not enabled[stateKey]
        refreshVisual()
        if onToggle then onToggle() end
    end)

    toggles[stateKey] = toggleObj
    return toggleObj
end

