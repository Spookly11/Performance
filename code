--==================================================
-- Open / Close Animation
--==================================================

local OpenPosition = UDim2.new(1,8,0,0)
local ClosedPosition = UDim2.new(1,-10,0,0)

local function ToggleSettings()

	SettingsOpen = not SettingsOpen

	if SettingsOpen then

		Tween(
			SettingsPanel,
			0.25,
			{
				Position = OpenPosition
			}
		):Play()

		Tween(
			GearButton,
			0.25,
			{
				Rotation = 90
			}
		):Play()

	else

		Tween(
			SettingsPanel,
			0.25,
			{
				Position = ClosedPosition
			}
		):Play()

		Tween(
			GearButton,
			0.25,
			{
				Rotation = 0
			}
		):Play()

	end

end

GearButton.MouseButton1Click:Connect(ToggleSettings)
