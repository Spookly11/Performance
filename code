unloadButton.MouseButton1Click:Connect(function()
    -- Save the island's current position so the next execution restores it.
    persistPosition(topBar.Position)
    unloaded = true
    if renderConn then
        renderConn:Disconnect()
    end
    for _, conn in ipairs(lbConnections) do
        conn:Disconnect()
    end
    screenGui:Destroy()
end)
